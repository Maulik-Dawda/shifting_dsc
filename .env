# =====================================================================
# DSC Office Shifting Inventory - Database Configuration
# Fill in your Hostinger MySQL details below.
# =====================================================================

# Database Driver: 'mysql' (for Hostinger / cPanel) or 'sqlite' (for local testing without MySQL)
DB_DRIVER=mysql

# Hostinger MySQL Database Settings
# Find these in Hostinger hPanel -> Databases -> MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_shifting_dsc
DB_USER=u123456789_dsc_user
DB_PASS=YourDatabasePasswordHere

# Application Mode
APP_ENV=production
APP_DEBUG=true
