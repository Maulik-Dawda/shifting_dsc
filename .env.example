# =====================================================================
# DSC Office Shifting Inventory - Environment Configuration
# Copy this file to .env on Hostinger and fill in your database details.
# DO NOT commit your actual .env file to Git!
# =====================================================================

# Database Driver: 'mysql' (for Hostinger / cPanel / Production) or 'sqlite' (for local test)
DB_DRIVER=mysql

# Hostinger MySQL Database Credentials
# (Found in Hostinger hPanel -> Databases -> MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_shifting_dsc
DB_USER=u123456789_dsc_user
DB_PASS=YourStrongHostingerDatabasePassword

# Application Settings
APP_ENV=production
APP_DEBUG=false
